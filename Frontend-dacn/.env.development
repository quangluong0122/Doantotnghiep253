# Frontend Environment Variables for Development

# API Endpoint for local development
REACT_APP_API_URL=http://localhost:5000/api

# ========================================
# Local Development Notes
# ========================================

# This .env.development file is automatically used by React
# when running: npm start

# Make sure your backend is running on localhost:5000
# Otherwise, update REACT_APP_API_URL to match your backend URL

# Common issues:
# 1. Backend not running: npm run dev (in Backend-dacn/)
# 2. Wrong port: Check PORT in Backend-dacn/.env
# 3. CORS errors: Check CORS config in Backend-dacn/src/index.js

# ========================================

# Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# For Local Development:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=employee_management_db

# For a hosted MySQL provider, DATABASE_URL takes precedence over DB_*:
# DATABASE_URL=mysql://user:password@host:port/database
# DB_SSL=true

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# CORS Configuration (for frontend)
CORS_ORIGIN=http://localhost:3000,https://doantotnghiep253.vercel.app

# API Configuration
API_URL=http://localhost:5000

# ========================================
# 🚆 Railway Deployment Instructions
# ========================================

# 1. In Railway Dashboard:
#    - Go to Variables tab
#    - Set all environment variables

# 2. For DATABASE_URL (Railway MySQL):
#    - Railway auto-generates this
#    - Copy from MySQL service Variables
#    - Format: mysql://user:password@host:port/db

# 3. For JWT_SECRET:
#    - Generate a random secure string
#    - Example: openssl rand -base64 32

# 4. For CORS_ORIGIN:
#    - Add your Vercel frontend URL
#    - Keep localhost for development

# 5. After setting variables:
#    - Deploy will auto-restart with new config
#    - Check Logs tab for errors

# ========================================
